          {
            "$ref": "#/$defs/StudentVisibleOutputEvent"
          },
          {
            "$ref": "#/$defs/StateChangedEvent"
          },
          {
            "$ref": "#/$defs/SubmissionAttemptEvent"
          },
          {
            "$ref": "#/$defs/SubmissionSucceededEvent"
